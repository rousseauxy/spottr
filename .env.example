# ─── Usenet (required) ────────────────────────────────────────────────────────
NNTP_HOST=news.example.com
NNTP_PORT=563
NNTP_TLS=true
NNTP_USER=youruser
NNTP_PASS=yourpassword
# Hard ceiling on concurrent upstream connections. Providers cap these per
# account, so this bounds how much load Spottr can put on your subscription.
NNTP_MAX_CONNS=4

# ─── Sync ─────────────────────────────────────────────────────────────────────
# How often to poll for new spots
SYNC_INTERVAL=15m
# How many articles to reach back on the FIRST run only. Forward sync never
# revisits anything older, so everything before this window needs BACKFILL.
SYNC_LOOKBACK=500000
# Walk history backwards towards the group's first article. Checkpoints after
# every chunk and resumes across restarts; paced deliberately because it shares
# the NNTP pool with live traffic.
BACKFILL=false

# ─── Authentication ───────────────────────────────────────────────────────────
# password — built-in login, requires APP_PASSWORD (default)
# proxy    — an authenticating reverse proxy (Authentik, oauth2-proxy, ...) is
#            the ONLY route in and owns authentication
# open     — no authentication at all
#
# Spottr refuses to start in `password` mode without APP_PASSWORD rather than
# silently serving privileged endpoints to anonymous callers.
AUTH_MODE=password
APP_PASSWORD=

# How long a session cookie stays valid
SESSION_DURATION=24h
# Set the Secure flag on the session cookie. Enable whenever Spottr is reachable
# over HTTPS.
SECURE_COOKIE=false

# Comma-separated CIDRs (or bare IPs) allowed to set X-Forwarded-For /
# X-Real-Ip / X-Forwarded-Proto and, with AUTH_MODE=proxy, the sign-in header
# below. Leave empty to always use the socket peer. List the address the proxy's
# requests ARRIVE FROM (a VPN or router that rewrites the source changes it) and
# never a whole network your clients are on: anything listed can forge these
# headers, including the one that lets it download NZBs.
# TRUSTED_PROXIES=192.0.2.10/32

# With AUTH_MODE=proxy: the header the proxy sets for a signed-in user (Authentik
# forward auth). Believed only from TRUSTED_PROXIES; lets that user download NZBs.
# PROXY_AUTH_HEADER=X-authentik-username

# ─── SABnzbd (optional) ───────────────────────────────────────────────────────
SAB_HOST=sabnzbd
SAB_PORT=8080
SAB_API_KEY=
SAB_TLS=false

# ─── Newznab API key (optional) ───────────────────────────────────────────────
# Leave empty to let the database own the key: it is generated once, logged on
# that run, and then stable across restarts AND container recreation.
# Set it to pin the key declaratively (e.g. from a secret manager).
API_KEY=

# ─── Limits ───────────────────────────────────────────────────────────────────
# Bound how expensive a single anonymous request can be.
MAX_PAGE_SIZE=200
MAX_OFFSET=100000
# Cap on one NNTP article read (32 MiB)
MAX_ARTICLE_BYTES=33554432
# Cap on DECOMPRESSED NZB size (64 MiB). NZBs are deflate streams from a public
# newsgroup, so the expansion ratio is attacker-controlled — pair this with a
# container memory limit.
MAX_NZB_BYTES=67108864
# Per-IP token bucket
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=30

# ─── Retention / cache ────────────────────────────────────────────────────────
# Delete spots older than N days. 0 keeps everything forever.
RETENTION_DAYS=0
# Evict cached NZB/image blobs beyond this (512 MiB). Both caches are pure
# caches; anything evicted is re-fetchable from Usenet.
CACHE_MAX_BYTES=536870912

# ─── Content & moderation ─────────────────────────────────────────────────────
# Allow 18+ spots: they then appear on an 18+ tab of their own, and nowhere else
# (not in All, other filters or searches; Newznab category 6000 on its own).
ALLOW_ADULT=false

# External spotter list feeds (XML)
# BLACKLIST_URL=https://spotlist.store/spotnet/blacklist.xml
# WHITELIST_URL=
BLACKLIST_URL=
WHITELIST_URL=

# Drop spots whose header signature does not validate. Off by default: legacy
# spots (keyid 1) are unsigned by design and would all be discarded.
VERIFY_SIGNATURES=false

# Honour Spotnet withdrawal ("DISPOSE") messages: off | mark | delete.
# The control messages themselves are ALWAYS kept out of the index; this only
# decides what happens to the spot they target. A poster's own withdrawal is
# applied when it is signed by the spot's own spotter and arrives within 5 days;
# one signed with the network moderator's key applies to any spot, as in Spotweb.
# With mark or delete the first start also applies the withdrawals of the past.
# Start with `mark` (reversible) before considering `delete`.
MODERATION_MODE=off

# ─── Misc ─────────────────────────────────────────────────────────────────────
TZ=Europe/Brussels
DB_PATH=/data/spottr.db
LISTEN_ADDR=:8080
